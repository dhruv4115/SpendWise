# Copy to android/key.properties and fill in. That file is gitignored, and
# must never be committed: it names a keystore and carries its passwords.
#
#   keytool -genkey -v -keystore ~/spendwise-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias spendwise
#
# storeFile is resolved relative to android/app/, so an absolute path is the
# safer answer — and keeps the keystore itself out of the repository.

storePassword=change-me
keyPassword=change-me
keyAlias=spendwise
storeFile=/absolute/path/to/spendwise-release.jks
